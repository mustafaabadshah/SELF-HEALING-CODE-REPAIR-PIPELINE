# Groq LLM API Configuration
GROQ_API_KEY=
CODER_MODEL=openai/gpt-oss-120b
CRITIC_MODEL=openai/gpt-oss-20b

# Observability (Langfuse)
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Persistence
DATABASE_URL=sqlite+aiosqlite:///./data/repair.db

# Execution & Sandbox Limits
MAX_ATTEMPTS=3
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_MEMORY_MB=512
SANDBOX_CPU_LIMIT=1
USE_DOCKER_SANDBOX=auto

# Mock Mode (runs deterministic self-healing loops without LLM API costs)
MOCK_LLM=false

# Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173
